# Copy to .env to point the app at a specific backend.
# Leave unset in development: the app uses the laptop running `npx expo start`
# (port 8002), which is what makes it work on a phone on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=https://staging.example.com/api/v1
# Where the web app lives (the ID card's QR code links to <web>/verify/<id>).
# EXPO_PUBLIC_WEB_URL=https://staging.example.com
